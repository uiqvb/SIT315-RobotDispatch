# Real environment files for the containerised deployments. The .example
# files beside them are committed; these hold actual credentials.
.env
.env.staging
.env.prod
.env.test
!.env.staging.example
!.env.prod.example

# Local dev secrets — never commit
RobotControllerApi_BASIC_SECRETS_README.md
docs/archive/RobotControllerApi_BASIC_SECRETS_README.md
*.secrets.json
appsettings.*.local.json

# Nano firmware — lives in its own repo, and the sketches carry hardcoded
# WiFi + device credentials in plaintext.
Firmware/
*.ino
code_final*

# Local working notes (not part of the published project)
docs/
context.md
wwwroot/*.backup.html
wwwroot/index.5tab-backup.html

# Editor / IDE
.vs/
.vscode/
*.lscache

## Ignore Visual Studio temporary files, build results, and
## user-specific files

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
bin/
obj/
Debug/
Release/

# Visual Studio cache/options
*.VC.db
*.VC.opendb

# ASP.NET Scaffolding
/.vs/

# NuGet
*.nupkg
**/packages/*
!**/packages/build/

# Rider
.idea/

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini
*.DS_Store

# dotnet tools
*.dotCover

# Logs
*.log

# Publish output
publish/

# JetBrains Rider
/.idea/

# IIS Express
Documents/**/IISExpress/
