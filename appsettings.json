{
  "Persistence": {
    "Provider": "ADO"
  },
  "WorkDispatch": {
    "LeaseMinutes": 5,
    "MaxQueuedWorkItemsPerDevice": 3,
    "StaleExpirySweepSeconds": 15
  },
  "Backpressure": {
    "PermitLimit": 64,
    "QueueLimit": 32,
    "RetryAfterSeconds": 1
  },
  "Database": {
    "MaxAutoPrepare": 64
  },
  "DeviceAuth": {
    "LastUsedPersistIntervalMinutes": 10
  },
  "RequestLogging": {
    "Enabled": true,
    "MaxBodyChars": 4000,
    "ShowHeaders": false,
    "ShowRequestBody": true,
    "ShowResponseBody": true,
    "IgnorePathPrefixes": [ "/swagger", "/favicon.ico", "/_framework" ],
    "ShowSuppressedSummary": true,
    "SuppressedSummarySeconds": 10,
    "QuietPolling": [
      {
        "PathStartsWith": "/api/adapter/devices/",
        "PathEndsWith": "/live-control-command",
        "Method": "GET",
        "WhenResponseJsonProperty": "isExpired",
        "EqualsValue": "true",
        "Because": "no live command"
      },
      {
        "PathEndsWith": "/work-items/claim-next",
        "Method": "POST",
        "WhenStatusIn": [ 204 ],
        "Because": "no queued work"
      },
      {
        "PathStartsWith": "/api/devices/",
        "PathEndsWith": "/capabilities",
        "Method": "GET",
        "WhenStatusIn": [ 200 ],
        "Because": "dashboard refresh"
      },
      {
        "PathStartsWith": "/api/devices/",
        "PathEndsWith": "/jobs",
        "Method": "GET",
        "WhenStatusIn": [ 200 ],
        "Because": "dashboard refresh"
      },
      {
        "PathStartsWith": "/api/devices/",
        "PathEndsWith": "/workflows",
        "Method": "GET",
        "WhenStatusIn": [ 200 ],
        "Because": "dashboard refresh"
      },
      {
        "PathStartsWith": "/api/devices/",
        "PathEndsWith": "/job-history",
        "Method": "GET",
        "WhenStatusIn": [ 200 ],
        "Because": "dashboard refresh"
      },
      {
        "PathEndsWith": "/api/device-status",
        "Method": "GET",
        "WhenStatusIn": [ 200 ],
        "Because": "dashboard refresh"
      },
      {
        "PathEndsWith": "/api/device-credentials",
        "Method": "GET",
        "WhenStatusIn": [ 200 ],
        "Because": "dashboard refresh"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
